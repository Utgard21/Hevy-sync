<?xml version="1.0"?>
<Container version="2">
<Name>hevy-dashboard</Name><Repository>ghcr.io/utgard21/hevy-sync:latest</Repository><Registry>https://github.com/Utgard21/Hevy-sync/pkgs/container/hevy-sync</Registry><Network>bridge</Network><Privileged>false</Privileged><Support></Support><Project>https://api.hevyapp.com/docs/</Project><Overview>Self-hosted Hevy workout progress dashboard. Requires a successful GitHub Actions image publication; see README. API key requires Hevy Pro; CSV import works without an API key.</Overview><Category>Other:</Category><WebUI>http://[IP]:[PORT:8080]/</WebUI><ExtraParams>--user 99:100</ExtraParams><PostArgs></PostArgs><Icon></Icon>
<Config Name="Web port" Target="8080" Default="8085" Mode="tcp" Description="Dashboard HTTP port" Type="Port" Display="always" Required="true" Mask="false">8085</Config>
<Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/hevy-dashboard" Mode="rw" Description="SQLite workout storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hevy-dashboard</Config>
<Config Name="Hevy API key" Target="HEVY_API_KEY" Default="" Mode="" Description="Hevy Pro developer API key; optional for CSV import" Type="Variable" Display="always" Required="false" Mask="true"></Config>
<Config Name="Timezone" Target="TZ" Default="Europe/Sofia" Mode="" Description="IANA timezone for workout dates and weeks" Type="Variable" Display="always" Required="true" Mask="false">Europe/Sofia</Config>
<Config Name="Sync interval" Target="SYNC_INTERVAL" Default="3600" Mode="" Description="Seconds between syncs (minimum 300)" Type="Variable" Display="advanced" Required="true" Mask="false">3600</Config>
</Container>
